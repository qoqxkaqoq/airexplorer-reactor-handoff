               </ul>\n                </li>\n\n                <li class=\"nav-item\">\n                    <a class=\"nav-link \" href=\"/tools/\">Tools</a>\n                </li>\n\n                <li class=\"nav-item\">\n                    <a class=\"nav-link \" href=\"/about/\">About</a>\n                </li>\n            </ul>\n\n            <ul class=\"navbar-nav\">\n                <li class=\"nav-item dropdown\">\n                    \n                        <a href=\"/users/login/\" class=\"nav-link\">\n                            <img src=\"/static/img/default-avatar.png\" class=\"avatar\" alt=\"Avatar\"> Login\n                        </a>\n                    \n                </li>\n            </ul>\n        </div>\n    </div>\n</nav>\n\n\n            <section id=\"content\">\n                \n\n                \n\n                \n    <section id=\"technique-detail\" class=\"container\">\n        \n\n        <h2 class=\"bottom-bordered pt-4\">.Net Reactor</h2>\n\n        <div class=\"mt-5 markdown\">\n            <p>.NET Reactor is used to prevent reverse engineering by adding different protection layers to .NET assemblies. Beside standard obfuscation techniques it includes special features like NecroBit, Virtualization, x86 Code Generation or Anti Tampering.</p>\n        </div>\n\n        <p class=\"text-center my-5\">\n            <span class=\"dot-sep\"></span>\n        </p>\n\n        \n            \n                <hr class=\"mt-5 dark\">\n\n                <div class=\"row\">\n                    \n                        <div class=\"col-12 col-xs-12 col-md-12 col-lg-6 col-sm-12\">\n                            <h5>Technique Identifier</h5>\n\n                            <p class=\"responsive-center\">\n                                \n                                    \n\n\n    \n        <a href=\"/search/?keyword=U1423\" class=\"badge badge-primary\">U1423</a>\n    \n\n                                \n                            </p>\n                        </div>\n                    \n\n                    \n                </div>\n\n            \n        \n\n         \n\n        <section>\n            <h5 class=\"mb-3 mt-5\">Evasion Categories</h5>\n\n            <div class=\"row g-4 mb-5\">\n    \n        <div class=\"col-12 col-md-6 col-lg-4 col-xl-3\">\n            <a href=\"/techniques/?pre_select=packers\" target=\"_blank\" class=\"dark-bg hoverable hover-bg rounded d-flex align-items-center p-2 gap-3\">\n            <img src=\"/media/2024/04/08/icons8-compress.svg\" alt=\"Packers icon\" width=\"30\" class=\"img-fluid rounded-circle img-thumbnail shadow-sm\">\n\n\n                <h6 class=\"ml-4 m-0\">Packers</h6>\n            </a>\n        </div>\n    \n</div>\n        </section>\n\n        \n\n        \n            <section class=\"detection-rules my-5\">\n                <h3>Detection Rules</h3>\n\n                <nav class=\"tab-container mt-3\">\n                    <ul class=\"nav nav-tabs\" role=\"tablist\">\n                        \n                            \n                                \n                                \n                            \n                            \n                            \n\n                            <li class=\"nav-item\" role=\"presentation\">\n                                <button class=\"nav-link active\" id=\"YARA1-tab\" data-bs-target=\"#YARA1\" type=\"button\" role=\"tab\" aria-controls=\"YARA1\" data-bs-toggle=\"pill\" aria-selected=\"true\">YARA</button>\n                            </li>\n                        \n                    </ul>\n\n                    <div class=\"tab-content\">\n                        \n                            \n                                \n                                \n                            \n                            \n                            \n\n                            <div class=\"tab-pane fade show show active\" id=\"YARA1\" role=\"tabpanel\" aria-label